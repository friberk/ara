# Run python3 scripts/bootstrap.py to create an ignored .env with random passwords.
# Add hosted credentials only to .env. Keep this example free of credentials.
COMPOSE_PROJECT_NAME=ara
POSTGRES_USER=ara
POSTGRES_DB=ara
POSTGRES_PASSWORD=replace-with-random-postgres-password
REDIS_PASSWORD=replace-with-random-redis-password
MINIO_ROOT_USER=ara-local
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
MINIO_BUCKET=research-pdfs
API_PORT=8000
FRONTEND_PORT=5173
APP_ENV=development
OPENAI_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
DEFAULT_MODEL=gpt-5.6-luna
DEFAULT_REASONING_EFFORT=low
# Customize when changing frontend ports or browser origins; Pydantic JSON array.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LLM_DAILY_BUDGET_USD=5

# Experimental open (local) models, frozen (ARA-090). To enable them, set this to true and add
# COMPOSE_PROFILES=open-models so Compose starts the Ollama runtime and the model worker.
EXPERIMENTAL_OPEN_MODELS=false
# Managed local runtime (open models only): weights are downloaded only from the Models UI.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_MAX_OUTPUT_TOKENS=2048
OLLAMA_NUM_THREADS=4
OLLAMA_REQUEST_TIMEOUT_SECONDS=900
OLLAMA_PULL_TIMEOUT_SECONDS=21600
OLLAMA_STALL_SECONDS=120
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_CPUS=4
OLLAMA_BUILD_JOBS=2
# Exact public PDF hostnames; additional hosts still undergo DNS/redirect validation.
FULLTEXT_ALLOWED_HOSTS='["arxiv.org","export.arxiv.org","aclanthology.org","pmc.ncbi.nlm.nih.gov","europepmc.org","proceedings.neurips.cc","openaccess.thecvf.com","pdfs.semanticscholar.org","link.springer.com","www.nature.com","nature.com","static-content.springer-cdn.com","ieeexplore.ieee.org","dl.acm.org"]'
# Context budgets in real tokens (ARA-076). Local input is capped for CPU latency.
LOCAL_INPUT_BUDGET_TOKENS=3072
OLLAMA_THINKING_TOKENS=1024
LOCAL_TOKEN_FACTOR=1.05
HOSTED_WORKING_CONTEXT_TOKENS=64000
MEMORY_COMPACTION_RATIO=0.6
# Local models kept resident together (chat, search, reranker).
OLLAMA_MAX_LOADED_MODELS=3
